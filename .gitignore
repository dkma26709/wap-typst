__pycache__/
*.pyc

# Compiled output and the local Pages staging directory; CI rebuilds both.
out/
_site/

# Per-book extracted artwork. Covers are promoted into assets/covers/, and the
# parchment background into assets/images/; the rest is not used.
build/images/

# The extraction intermediates. A book is imported once into src/ and owned by
# hand from then on, so keeping its JSON would be keeping a second copy of the
# same book that nothing reads and nothing keeps in step. Extraction still
# writes these, on the machine that has the PDFs; they are simply not committed.
# git history holds the verified ones if a baseline is ever wanted again.
build/*
!build/render.json
