#field("SPECIAL RULES", "Forest Strider, Primal Fury")
#items(((runs: ((emph: "bold", text: "Bagrar the Tamer:"), (emph: "", text: " If Gorthor is mounted on a Chariot, he may re-roll all Charge, Flee and Pursuit distance rolls. If Gorthor is on foot, Bagrar is not included in the game.")), sub: ()), (runs: ((emph: "bold", text: "Chariot Master:"), (emph: "", text: " If Gorthor is included in your army, you may take Tuskgor Chariots as Core Units instead of Special Units.")), sub: ()), (runs: ((emph: "bold", text: "The Favoured of Chaos:"), (emph: "", text: " Gorthor must be the Army General. Gorthor, and any unit he joins, may re-roll failed Psychology and Break tests.")), sub: ()), (runs: ((emph: "bold", text: "Scion of the Dark Gods:"), (emph: "", text: " At the start of each friendly Magic phase, randomly generate a spell from the Lore of Chaos up to Level 2. Gorthor may use this spell during this Magic phase as a Bound Spell, with a Power Level equal to half the casting value of the spell, rounding up.")), sub: ())))
