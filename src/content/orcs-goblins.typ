#items(((runs: ((emph: "", text: "May be upgraded to one of the following:"),), sub: (((emph: "", text: "Night Goblin free"),), ((emph: "", text: "Forest Goblin free"),))), (runs: ((emph: "", text: "May be upgraded to Little Big 'Uns +2 points/model"),), sub: ()), (runs: ((emph: "", text: "May choose one of the following:"),), sub: (((emph: "", text: "Spears +0.5 point/model"),), ((emph: "", text: "Polearms (Common and Night Little Big 'Uns only) +2 points/model"),), ((emph: "", text: "Shortbows +2 points/model"),), ((emph: "", text: "Great weapons (Little Big 'Uns only) +3 points/model"),))), (runs: ((emph: "", text: "May take shields (unless armed with great weapons, bows or shortbows) +0.5 point/model"),), sub: ()), (runs: ((emph: "", text: "May take light armour (Common and Night Goblins only) +0.5 point/model"),), sub: ()), (runs: ((emph: "", text: "May include one Nasty Skulker for every 10 models in the unit (Common Goblins only) +6 points/model"),), sub: ()), (runs: ((emph: "", text: "May upgrade one Goblin Git to a Jester (Common Goblins only) +20 points"),), sub: ()), (runs: ((emph: "", text: "May upgrade one Goblin Git to a Netter for every 5 models in the unit (Night Goblins only) +2 points/Netter"),), sub: ()), (runs: ((emph: "", text: "May include one Fanatic for every 10 models in the unit (Night Goblins only) +25 points/model"),), sub: ()), (runs: ((emph: "", text: "May upgrade one Goblin Git to a Leader +5 points"),), sub: ()), (runs: ((emph: "", text: "May upgrade one Goblin Git to a Musician +5 points"),), sub: ()), (runs: ((emph: "", text: "May upgrade one Goblin Git to a Standard Bearer +10 points"),), sub: (((emph: "", text: "May take a Magic Standard worth up to 25 points"),),))))

