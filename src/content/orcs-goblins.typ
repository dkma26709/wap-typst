#para(((emph: "", text: "The bearer of the Necklace of Blessed Teef may re-roll any armour or Ward Save rolls of 1."),))
#namecost("SPARKLY WIZARD FINDA", "15 points")
#para(((emph: "", text: "The bearer of the Sparkly Wizard Finda has the Hatred (Wizards) and Magic Resistance (3) special rules."),))
