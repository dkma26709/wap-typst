#namecost("WARPFIRE BLADE", "10 points")
#para(((emph: "", text: "If the wielder of this weapon rolls a 6's To Hit, that Attack automatically Wounds with the Multiple Wounds (2) and Flaming Attacks special rules."),))
#namecost("WARPTONGUE BLADE", "10 points")
